{
  "name": "@chatlychat/mcp",
  "version": "0.1.3",
  "description": "Chatly MCP server — 83 typed tools (76 reads, 7 writes) over stdio or Streamable HTTP, for Claude, Cursor and any MCP client.",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "chatly-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "@types/node": "^20.14.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/chatlychat/chatly-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatlychat/chatly-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/chatlychat/chatly-mcp/issues"
  },
  "author": "Chatly",
  "license": "MIT",
  "keywords": [
    "chatly",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "livechat-alternative",
    "ai-tools"
  ]
}
